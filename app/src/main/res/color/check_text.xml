<?xml version="1.0" encoding="utf-8"?>
<!-- Checkbox label text: bright while D-pad focused, dim otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/text" />
    <item android:state_pressed="true" android:color="@color/text" />
    <item android:color="@color/text_dim" />
</selector>
