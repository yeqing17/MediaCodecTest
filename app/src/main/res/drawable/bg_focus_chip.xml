<?xml version="1.0" encoding="utf-8"?>
<!-- Focus outline chip drawn behind checkboxes; invisible until the row is
     D-pad focused, then shows an accent border. 2dp stroke in both states so
     content never shifts. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
